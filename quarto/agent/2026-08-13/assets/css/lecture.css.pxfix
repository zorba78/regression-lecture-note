/* Date: 2026-08-13 | Lecture-specific overrides on top of the reference deck's
   simple + monash theme. Only what this deck needs: the reference deck's slides
   are mostly text, whereas this one carries wide result tables, four-panel
   diagnostic figures, and long display equations. */

/* Slide title / subtitle scale. The H3 subheading is the reference deck's
   signature element, so keep it clearly subordinate to the H2 but still large. */
.reveal h2 {
  font-size: 1.55em;
  margin-bottom: 0.15em;
}
.reveal h3 {
  font-size: 1.05em;
  color: #27374a;
  margin-top: 0.15em;
  margin-bottom: 0.45em;
}

/* Font Awesome glyphs sit slightly high next to Korean text at this size. */
.reveal h3 i.fa-solid {
  font-size: 0.85em;
  margin-right: 0.25em;
  vertical-align: 0.02em;
}

/* Figures must never push the slide into vertical overflow. */
.reveal .slide img {
  max-height: 614px;   /* 60% of the 1024px canvas */
  width: auto;
  object-fit: contain;
}

/* Result tables are the densest content in this deck. They are centred and
   allowed to breathe: at 1280px the default width left them huddled in the
   middle of the slide with the caption wrapping inside the table's own width. */
.reveal table {
  font-size: 0.72em;
  margin-left: auto;
  margin-right: auto;
  min-width: 60%;
}
.reveal table th,
.reveal table td {
  padding: 0.25em 0.75em;
}

/* Markdown writes the caption after the table, so render it there too:
   an HTML <caption> otherwise jumps above the table. `caption-side` sizes the
   caption to the table, so the table minimum width above also keeps the
   caption from wrapping into a narrow column. */
.reveal table caption {
  caption-side: bottom;
  text-align: left;
  padding-top: 0.5em;
}
.reveal table caption,
.reveal figcaption {
  font-size: 0.8em;
  color: #52514e;
}

/* Display equations: the reference deck rarely stacks several per slide,
   this one does (variance derivation, Gauss-Markov, WLS/GLS). */
.reveal .slide .MathJax_Display,
.reveal mjx-container[display="true"] {
  margin: 0.5em 0 !important;
}

/* Safety net for equations wider than the slide. Display math does not wrap,
   so an over-long line is silently clipped at the right edge; this makes it
   scroll instead of disappear. Long equations should still be stacked with
   an aligned environment in the source: this only stops silent data loss. */
.reveal .slides section .MathJax_Display,
.reveal .slides section mjx-container[display="true"] {
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
}

/* Same guard for wide tables and columns. */
.reveal .slides section .column {
  min-width: 0;
}

/* Callout boxes carry definitions and proofs here, so tighten their padding
   to leave room for the equations inside them. */
.reveal div.callout {
  margin-top: 0.5em;
  margin-bottom: 0.5em;
}
.reveal div.callout .callout-body,
.reveal div.callout div.callout-body-container {
  font-size: 0.92em;
}

/* Blockquote = formal definition/proposition, following the reference deck. */
.reveal blockquote {
  font-size: 0.95em;
  width: 100%;
  margin: 0.4em 0;
}

/* Code blocks are illustrative, not the focus. */
.reveal pre code {
  font-size: 0.72em;
  max-height: 471px;   /* 46% of the 1024px canvas */
}

/* Aside = provenance line ("Computed by ..."). Keep it quiet. */
.reveal .aside,
.reveal div.aside {
  font-size: 0.62em;
  color: #6b6a66;
}

/* ---------------------------------------------------------------------------
   Adopted from references/obesity-pulse-presentation/custom.scss (2026-08-24).
   Only the deck-independent parts were taken: the H2 treatment, the table
   treatment, the column gap, and the italic figure caption.

   Deliberately NOT taken, because they would fight the settings above:
     - $presentation-font-size-root: 26px and the h1/h2/h3 sizes. That deck is
       1280x720; this one is 1280x1024 and its type scale is tuned above.
     - .reveal table { font-size: 0.66em; width: 100% }. Table sizing and
       centring are already set above for this deck's wider result tables.
     - .small / .smaller / .muted / .center-text. `.smaller` is a built-in
       Quarto class used on 61 slides here; redefining it to 0.68em would
       rescale all of them.
     - The study-specific classes (.ctrl/.gyn/.andr, .badge, .banner, .card,
       .tone-*, .chip, .phenotype-card, .body-fig, .col-head, .sig/.nonsig).
       None of them are used by this deck.
   --------------------------------------------------------------------------- */

/* Korean-capable sans-serif stack. The reference sets this through the SCSS
   variable $font-family-sans-serif, which works on its `default` theme but not
   here: the `simple` theme this deck uses pins its own 'Source Sans Pro'. So it
   is applied as a plain rule instead, which loads after the theme and wins.
   A font stack only, with no webfont import, so the deck loads no external
   resource; where Noto Sans KR is absent it falls back to Malgun Gothic, the
   Windows Korean default. Font Awesome glyphs and code blocks are untouched:
   both carry their own font-family on a more specific selector. */
.reveal .slides section,
.reveal h1, .reveal h2, .reveal h3, .reveal h4,
.reveal .quarto-title-block {
  font-family: "Noto Sans KR", "Malgun Gothic", "Apple SD Gothic Neo", sans-serif;
}

/* Slide titles: academic blue with a rule under them. Margin and font size
   stay as set above; only colour and the underline are added. */
.reveal h2 {
  color: #14324a;
  border-bottom: 3px solid #3b9ab2;
  padding-bottom: 0.12em;
}

/* Result tables: dark header band, hairline grid, zebra body. */
.reveal table th {
  background: #14324a;
  color: #ffffff;
  border: 1px solid #cfd8dd;
  text-align: center;
}
.reveal table td {
  border: 1px solid #d7dee2;
  vertical-align: middle;
}
.reveal table tbody tr:nth-child(even) {
  background: #f4f7f9;
}

/* Two-column slides sat flush against each other at this width. */
.reveal .columns {
  gap: 1.2em;
}

/* Figure captions italic, matching the reference deck. Size and colour are
   already set above. */
.reveal figcaption {
  font-style: italic;
}

/* ===========================================================================
   Date: 2026-08-27 | Slide layout system, applied to all eight chapter decks
   (they all load this file). Chosen from the layout candidates reviewed on
   2026-08-27; see output/agent/2026-08-27/design/.

     A  (no class)  base grid. The slide is a vertical stack that fills the
                    1024px canvas: the definition blockquote reads as a tinted
                    band and the closing callout is pinned to the bottom edge
                    instead of floating in the middle of the slide. Measured
                    before this change: 300-370px of dead space at the foot of
                    the sparser slides (신뢰구간, 직교벡터, 대각합, 멱등행렬).
     B  .rail      concept rail left, working area right, both full height.
     C  .fig-led    the figure takes the full content width; the read-out sits
                    under it, pinned to the foot.
     D  .stepped    numbered derivation steps with a dark conclusion band.

   The base grid is deliberately CSS-only so no slide source had to be
   rewritten; B/C/D are opt-in classes on the H2.
   =========================================================================== */

/* --- A: base grid ---------------------------------------------------------
   `height: 100%` turns the section into a full-canvas flex column so that an
   `auto` top margin can push the closing band down. `flex-shrink: 0` on the
   children is the safety catch: without it a slide whose content already
   exceeds the canvas would be squashed rather than overflowing as before.

   Scoped to `.present` on purpose: reveal drives slide visibility with an
   inline `display` (none for far slides, block for near ones), so a blanket
   `display: flex !important` would force every slide visible at once. Only
   the slide on screen carries .present, and only there does the inline
   `block` need overriding. Off-screen preloads keep block layout, which does
   not matter visually; PDF print mode also stays block, so the pin is a
   screen refinement, not a PDF one.

   `.dense` opts a slide out entirely. A flex container does NOT collapse the
   vertical margins between adjacent children, so switching a slide from block
   to flex silently ADDS a margin at every boundary: three callouts each
   carrying an inline `margin-top: 1em; margin-bottom: 1em` cost 1em per gap in
   block layout and 2em here. On a slide that was already full that is the
   difference between fitting and clipping. Measured on 01 "Galton 자료에 대한
   단순선형모형 적합": bottom-band ink 0 with the pre-layout CSS, 6072 with this
   rule, back to 0 with this rule disabled and everything else left in place.
   CSS cannot ask for collapsed margins inside a flex container, so a slide
   with no spare height has to stay block. See the `.dense` block below. */
.reveal .slides section.slide.level2.present:not(.dense) {
  display: flex !important;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}
.reveal .slides section.slide.level2.present:not(.dense) > * {
  flex-shrink: 0;
}

/* Print/PDF export takes the same grid. Reveal shows every section in this
   mode (html.print-pdf), so there is no display:none to fight and no
   !important is needed; without this rule the exported PDF would silently
   fall back to the pre-2026-08-27 block layout while the screen deck used
   the new one. */
html.print-pdf .reveal .slides section.slide.level2:not(.dense) {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}
html.print-pdf .reveal .slides section.slide.level2:not(.dense) > * {
  flex-shrink: 0;
}

/* The closing band. `:last-of-type` counts the last <div> child, so the rule
   fires only when the callout really is the last block on the slide; a slide
   ending in an .aside provenance line pins that instead, which is where a
   footnote belongs anyway. `aside.notes` is a different tag and never counts.

   The `:not(:has(~ *:not(aside)))` guard is what stops the pin from throwing
   trailing content off the slide. Without it, a slide that ends with a
   callout FOLLOWED BY a paragraph (06 "일반화최소제곱(GLS): WLS와의 관계")
   pushed those three paragraphs past the bottom edge, silently. The guard
   reads: pin only when this callout has no later sibling other than the
   speaker-notes aside. Where :has() is unsupported the whole rule is dropped
   and nothing pins, which is the safe way to fail.

   No padding-bottom on the section: an earlier version had 0.9em there and it
   cost every slide about 29px of usable height, which tipped five already-full
   slides into clipping (verified against the pre-change CSS: all measured 0
   overflow before, non-zero after). The breathing room goes on the pinned
   element instead. */
.reveal .slides section.slide.level2:not(.rail):not(.dense) > div.callout:last-of-type:not(:has(~ *:not(aside))),
.reveal .slides section.slide.level2:not(.rail):not(.dense) > div.aside:last-of-type:not(:has(~ *:not(aside))) {
  margin-top: auto;
  margin-bottom: 0.35em;
}

/* Definition band. The quote rule alone read as a soft left tick at 1280px;
   the tint gives the definition a shape the audience can find on every slide. */
.reveal .slides section blockquote {
  background: #f4f7f9;
  border-left: 5px solid #3b9ab2;
  padding: 0.5em 0.8em;
}

/* --- A escape hatch: .dense ----------------------------------------------
   For the handful of slides whose content already fills the canvas. The class
   means "this slide has no spare height", and it gives back every pixel the
   layout takes: the flex column (see above) and the band's vertical padding,
   which is 0.5em top and bottom on a slide that cannot spare it. The tint and
   the teal rule stay, so the slide still reads as part of the deck. The pin is
   excluded as well - in block layout `margin-top: auto` computes to 0, which
   would strip the closing callout's normal top margin instead of pushing it
   down.

   Measured on 05 "선택 후 재진단": bottom-band ink 530 with the layout, 433
   with the flex column off but the band padding still on, 0 with both off.
   Carried by 8 slides as of 2026-08-27; 02 "행렬 표기의 필요성" is on the list
   because the layout made it worse (1127 -> 1611), but it overflowed by 1127
   before any of this work and .dense only returns it to that state. */
.reveal .slides section.slide.level2.dense blockquote {
  padding-top: 0;
  padding-bottom: 0;
}

/* --- B: .rail ------------------------------------------------------------
   For slides whose definition is short enough to live in a 430px rail. The
   author still writes a normal two-column block; this only makes the columns
   run the full height and tints the first one. */
/* Specificity has to match the base grid's own child rule, hence the repeated
   .slide.level2; the `flex` shorthand is used so nothing left over from a
   `flex: none` further up can win on the individual longhands. */
.reveal .slides section.slide.level2.rail > .columns {
  align-items: stretch;
}
/* The rail's height is set outright rather than grown with flex. `flex: 1 1
   auto` on the .columns block was tried first and never took effect inside
   reveal's section (verified on 전치: the tinted rail stopped at y=689 with
   and without it, and renaming the class ruled out a name clash). A fixed
   min-height is deterministic, and 72vh of the 1024px canvas puts the foot of
   the rail at about y=880, just above the closing band. */
.reveal .slides section.slide.level2.rail > .columns > .column:first-child {
  min-height: 737px;   /* 72% of the 1024px canvas */
}
/* An auto margin swallows all remaining free space before flex-grow gets a
   share of it, so on a .rail slide the two rails would never reach the foot
   while the base rule's pin was in force. Overriding the margin back to a
   fixed value did not help - the base pin is excluded with :not(.rail)
   instead, which is the only version that actually worked. Here the growing
   columns put the closing band at the bottom on their own. */
.reveal .slides section.slide.level2.rail > div.callout:last-of-type,
.reveal .slides section.slide.level2.rail > div.aside:last-of-type {
  margin-top: 0.4em;
}
.reveal .slides section.rail > .columns > .column:first-child {
  background: #f4f7f9;
  border-top: 4px solid #14324a;
  padding: 0.6em 0.8em;
  box-sizing: border-box;
}
.reveal .slides section.rail > .columns > .column:first-child blockquote {
  background: none;
  border-left: none;
  padding-left: 0;
}

/* --- C: .fig-led ----------------------------------------------------------
   Width wins over height for the one figure that carries the slide. The base
   rule caps every image at 60vh, which starves a 2:1 figure of about 200px of
   width at this canvas size. */
.reveal .slides section.fig-led img {
  width: 100%;
  height: auto;
  max-height: 512px;   /* 50% of the 1024px canvas */
}
.reveal .slides section.fig-led .quarto-figure,
.reveal .slides section.fig-led figure {
  width: 100%;
  margin: 0.2em 0;
}

/* Width only wins if the preamble gives it room. Measured on the likelihood
   slide: heading pair + definition + lead line ran to 440px, which left the
   figure 429px of height and so 948px of width - narrower than the 940px it
   already had. Tightening the preamble to about 315px is what actually buys
   the extra 200px of figure width, so these three rules are part of the
   layout, not decoration. */
.reveal .slides section.fig-led > h3 {
  font-size: 0.92em;
  margin-bottom: 0.18em;
}
.reveal .slides section.fig-led blockquote {
  font-size: 0.86em;
  padding: 0.35em 0.7em;
  margin: 0.25em 0;
}
.reveal .slides section.fig-led > p {
  margin: 0.28em 0;
}
.reveal .slides section.fig-led .caption,
.reveal .slides section.fig-led figcaption {
  margin-top: 0.1em;
}

/* --- D: .stepped ----------------------------------------------------------
   Numbered rail for a derivation written as an ordered list, and a dark band
   for the conclusion so the result of the argument is unmissable. */
.reveal .slides section.stepped ol {
  list-style: none;
  counter-reset: step;
  margin-left: 0;
  padding-left: 0;
}
.reveal .slides section.stepped ol > li {
  counter-increment: step;
  position: relative;
  padding-left: 2.1em;
  margin-bottom: 0.5em;
  border-left: 2px solid #cfd8dd;
}
.reveal .slides section.stepped ol > li::before {
  content: counter(step);
  position: absolute;
  left: -0.72em;
  top: 0;
  width: 1.45em;
  height: 1.45em;
  border-radius: 50%;
  background: #14324a;
  color: #ffffff;
  font-size: 0.72em;
  font-weight: 700;
  line-height: 1.45em;
  text-align: center;
}
.reveal .slides section.stepped > div.callout:last-of-type {
  background: #14324a;
  border: none;
  border-radius: 0;
}
.reveal .slides section.stepped > div.callout:last-of-type,
.reveal .slides section.stepped > div.callout:last-of-type .callout-body-container,
.reveal .slides section.stepped > div.callout:last-of-type strong {
  color: #ffffff;
}
/* The conclusion is one short statement; centre it and give it the weight of
   a result rather than of another bullet. */
.reveal .slides section.stepped > div.callout:last-of-type .callout-body-container {
  text-align: center;
  font-size: 1.05em;
  padding: 0.35em 0;
}
.reveal .slides section.stepped > div.callout:last-of-type mjx-container[display="true"] {
  margin: 0 !important;
}
